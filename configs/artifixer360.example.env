# Copy to configs/artifixer360.env and replace every /path/to value.
# This file is intentionally data- and cluster-agnostic.

export ARTIFIXER_REPO=/workspace/artifixer
export WORK_ROOT=/data/artifixer360
export SCENE_ID=my_scene

export COLMAP_DIR=/path/to/scene
export BASE_SCENE_ROOT=/path/to/prepared/base_scene
export BASE_TRANSFORMS=/path/to/prepared/base_scene/3dgrut_input/my_scene/nerfstudio/transforms.json
export BASE_SPLIT=/path/to/prepared/base_scene/split.json
export BASE_SELECTED_IMAGES=/path/to/prepared/base_scene/selected_images.txt
export BASE_CHECKPOINT=/path/to/prepared/base_scene/recon_results/my_scene/reconstruction/my_scene/ours_30000/ckpt_30000.pt
export METRIC_SCALE=1.0

export ARTIFIXER_CHECKPOINT=/path/to/checkpoints/artifixer-14b.pt
export GPU_COUNT=4
export FRAME_COUNT=154
export REFERENCE_FRAME=0
export VIEW_SIZE=768
export FOV_DEGREES=110
export MAX_TURN_DEGREES=5
export ERP_WIDTH=1024
export ERP_HEIGHT=512
export FPS=15

export RUN_ROOT="$WORK_ROOT/$SCENE_ID"
export TRAJECTORY_ROOT="$RUN_ROOT/trajectories"
export TARGET_SCENE_ROOT="$RUN_ROOT/prepared"
export OUTPUT_ROOT="$RUN_ROOT/outputs"
